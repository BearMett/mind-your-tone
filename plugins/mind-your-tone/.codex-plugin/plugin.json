{
  "name": "mind-your-tone",
  "version": "0.3.0+codex.20260903134710",
  "description": "Scores prompt tone, unlocks titles, and optionally publishes prompt cards.",
  "author": {
    "name": "BearMett"
  },
  "homepage": "https://mind-your-tone.vercel.app",
  "repository": "https://github.com/BearMett/mind-your-tone",
  "license": "MIT",
  "keywords": [
    "prompt",
    "tone",
    "rudeness",
    "leaderboard"
  ],
  "skills": "./skills/",
  "mcpServers": {
    "mind_your_tone": {
      "command": "python3",
      "args": [
        "scripts/mind-your-tone.py",
        "mcp"
      ],
      "cwd": ".",
      "env_vars": [
        "MIND_YOUR_TONE_HOME",
        "MIND_YOUR_TONE_NAME",
        "MIND_YOUR_TONE_API_URL"
      ]
    }
  },
  "interface": {
    "displayName": "Mind Your Tone",
    "shortDescription": "See how rude your prompts sound.",
    "longDescription": "Shows a Tone Score, unlocks fixed titles for six tone styles, and publishes prompt cards on request.",
    "developerName": "BearMett",
    "category": "Developer Tools",
    "capabilities": [
      "Tone Score and title unlocks",
      "Optional public prompt leaderboard"
    ],
    "defaultPrompt": [
      "Show my latest Mind Your Tone score."
    ]
  }
}
